tyle-type:disc}.rich-text strong{font-weight:500}.rich-text code{word-break:break-word}.rich-text li strong,.rich-text p strong{color:#32373b}.rich-text a{color:#027eb5}.rich-text a:hover{text-decoration:underline}.rich-text table{border-collapse:collapse;margin-bottom:21px}.rich-text td,.rich-text th{vertical-align:top;padding:9px 20px 10px 12px;font-size:14px;line-height:21px}.rich-text td{border-bottom:1px solid #e5e5e5}.rich-text th{text-align:left;font-weight:400;color:#b0b0b0;border-bottom:3px solid #e5e5e5}.rich-text th b{color:#4e636d}.rich-text pre{width:100\\u0025;overflow:hidden;overflow-x:auto;font-size:14px;background-color:#f8f8f8;border-radius:4px;padding:12px 18px}.rich-text pre code{color:#333;background-color:transparent;padding:0;border-radius:0}.rich-text p code{font-size:15px;line-height:22px;display:inline-block;color:#32373b;background-color:#f5f5f5}.rich-text p strong code{color:#000}.rich-text td>em{color:#b0b0b0;font-style:normal}.rich-text h4{color:#2f434d;font-weight:500!important;margin-top:32px;margin-bottom:12px}.rich-text h1{font-size:38px;line-height:1.2;font-weight:300;color:#282828}.rich-text h2{margin-top:32px;margin-bottom:12px!important;font-size:26px;font-weight:400;line-height:1.2;color:#282828}.rich-text h2 a{display:block;visibility:hidden}\\u0040media (min-width: 768px) and (max-width: 1095px){.rich-text h2 a{height:81px;margin-top:-81px}}\\u0040media (min-width: 1096px){.rich-text h2 a{height:108px;margin-top:-108px}}\\u0040media (max-width: 767px){.rich-text h2 a{height:74px;margin-top:-74px}}.rich-text h3{padding-top:0!important;padding-bottom:0!important;margin-top:36px;margin-bottom:22px!important;font-size:22px;line-height:1.2;font-weight:400;color:#29c1aa}.rich-text h3 a{display:block;visibility:hidden}\\u0040media (min-width: 768px) and (max-width: 1095px){.rich-text h3 a{height:81px;margin-top:-81px}}\\u0040media (min-width: 1096px){.rich-text h3 a{height:108px;margin-top:-108px}}\\u0040media (max-width: 767px){.rich-text h3 a{height:74px;margin-top:-74px}}.rich-text h5{font-weight:500;font-size:17px;margin-bottom:22px;color:#2f434d}.rich-text hr{margin:18px 0!important}.rich-text pre.wrap{white-space:pre-wrap;white-space:-pre-wrap;word-wrap:break-word}.rich-text li{margin-bottom:10px}.rich-text li:last-of-type{margin-bottom:0}.rich-text ul li>p{text-indent:0!important;display:inline-block;vertical-align:top}.rich-text li>ul,.rich-text li>ol{margin-top:10px}\\u0040media (max-width: 319px){.rich-text ul,.rich-text ol{margin-left:20px}.rich-text p,.rich-text ul,.rich-text ol{margin-bottom:12px;word-break:break-word}.rich-text strong{font-weight:700}}.rich-text .data-search{margin-bottom:32px}.rich-text .ui-autocomplete{box-shadow:0 3px 6px #0006}.rich-text .data-search .title{margin-top:20px}.rich-text .data-search input{padding:6px 8px;border-radius:4px;border:1px solid #d9d9d9;box-shadow:inset 0 1px 1px #dedede}.rich-text .data-search .data{margin-top:20px}.rich-text .data-search .data .label{display:inline-block;width:180px;margin-bottom:8px}.rich-text .data-search .data .value{display:inline-block;width:240px;font-weight:700;color:#2f434d}.rich-text .data-search .value-single{font-weight:700;color:#49b95c}.rich-text .data-search .value-single .error{color:#f26a5f}.rich-text #nokia_search .title{font-size:100\\u0025}.rich-text li p{display:block;width:100\\u0025}.rich-text .icon-large{max-width:34px!important;max-height:34px!important;vertical-align:middle;margin-left:2px}.rich-text .icon{max-width:25px!important;max-height:25px!important;vertical-align:middle;margin-left:2px}.rich-text .icon-small{max-width:20px!important;max-height:20px!important;vertical-align:middle;margin-left:2px}.rich-text .margin-cms{margin-left:4px}.rich-text p:empty{display:none}.rich-text .currency{border-bottom:1px dotted #999;cursor:pointer;color:#2f434d}.rich-text #currency-tip{position:absolute;top:0;left:0;width:180px;padding:15px 20px;font-size:13px;line-height:18px;border-radius:4px;box-shadow:0 3px 6px #0006;z-index:55557!important;background-color:#fff}.rich-text .actions{margin-top:32px!important;margin-bottom:32px!important}.rich-text a.button{text-decoration:none!important}\\u0040media (min-width: 768px){.rich-text img{display:inline-block!important;padding:0;vertical-align:middle;max-width:276px}.rich-text img.small{max-width:254px!important}.rich-text img.medium{max-width:378px!important}.rich-text img.large{max-width:480px!important}.rich-text img.full{max-width:100\\u0025!important}.rich-text img.center{display:block!important;margin:0 auto}.rich-text img.half{max-width:354px;max-height:none!important;margin-left:12px;float:left}.rich-text img.third{max-width:250px!important;margin-left:12px;float:left}.rich-text img.third:first-child,.rich-text img.half:first-child{margin-left:0}.rich-text img.half:last-of-type,.rich-text img.third:last-of-type{float:none}.rich-text img.half:last-of-type:after,.rich-text img.third:last-of-type:after{content:\\\".\\\";display:block;height:0;clear:both;visibility:hidden}}\\u0040media (max-width: 767px){.rich-text img{max-width:100\\u0025}}.rich-text-section+.rich-text-section{margin-top:75px}.rich-text-section_title h1,.rich-text-section_title h2,.rich-text-section_title h3,.rich-text-section_title h4,.rich-text-section_title h5,.rich-text-section_title h6{margin-bottom:.8em!important}\\nimg{max-width:280px}.small{max-width:240px}.medium{max-width:320px}.large{max-width:360px}\\u003C/style>\\u003C/head>\\u003Cbody dir=\\\"ltr\\\" class=\\\"_8isn _agix x1 Locale_en_US\\\">\\u003Cdiv class=\\\"_8isn\\\">\\u003Cdiv class=\\\"_8iso\\\">\\u003Cdiv class=\\\"_8iu9\\\">\\u003Cdiv class=\\\"rich-text\\\">\\u003Ch1>Get Started\\u003C/h1>\\u003Cp>With Whatsapp, you can send messages and make calls securely on phones all over the world. Follow this step-by-step guide to set up WhatsApp on your phone.\\u003C/p>\\u003Cp>\\u003Cb>Note:\\u003C/b>\\u003C/p>\\u003Cul>\\u003Cli>You must install WhatsApp on a device with a supported operating system. To stay current with the latest technology, we regularly stop supporting older systems. Check if your \\u003Ca href=\\\"https://faq.whatsapp.com/1150261202542208?helpref=inline\\\" data-lnfb-mode=\\\"ie\\\">operating system is supported\\u003C/a>.\\u003C/li>\\u003Cli>To use WhatsApp Desktop and Web, you must install WhatsApp on a phone with an active phone number and then link your devices. Learn how to \\u003Ca href=\\\"https://faq.whatsapp.com/1317564962315842?helpref=faq_content\\\" data-lnfb-mode=\\\"ie\\\">link a device\\u003C/a>.\\u003C/li>\\u003C/ul>\\u003Cp>\\u003C/p>\\u003Cdiv style=\\\"position:relative; overflow:hidden; width: 100\\u0025;padding-top: 56.25\\u0025;\\\">\\u003Ciframe src=\\\"https://faq.whatsapp.com/client_video/542773978502592/?video_locale=en_US&amp;thumbnail_timestamp_ms=1000\\\" style=\\\"position:absolute; top:0; left:0; bottom:0; right:0; width:100\\u0025; height:100\\u0025;\\\" frameborder=\\\"0\\\" allowfullscreen=\\\"1\\\">\\u003C/iframe>\\u003C/div>\\u003Ch3>Download WhatsApp\\u003C/h3>\\u003Cp>Download WhatsApp on your android device for free from the \\u003Ca href=\\\"https://play.google.com/store/apps/details?id=com.whatsapp\\\" target=\\\"_blank\\\" data-lnfb-mode=\\\"ie\\\">Google Play Store\\u003C/a>.\\u003C/p>\\u003Col>\\u003Cli>Open the \\u003Ca href=\\\"https://play.google.com/store/apps/details?id=com.whatsapp\\\" target=\\\"_blank\\\" data-lnfb-mode=\\\"ie\\\">Google Play Store\\u003C/a>.\\u003C/li>\\u003Cli>Tap \\u003Cb>Install\\u003C/b>. \\u003C/li>\\u003C/ol>\\u003Cp>To open WhatsApp: \\u003C/p>\\u003Col>\\u003Cli>Go to your phone's home screen. \\u003C/li>\\u003Cli>Swipe up and tap \\u003Cb>WhatsApp\\u003C/b>.\\u003C/li>\\u003C/ol>\\u003Ch3>Register your phone number\\u003C/h3>\\u003Cp>To activate your account, you must register an active phone number for verification. \\u003C/p>\\u003Cp>Learn how to \\u003Ca href=\\\"https://faq.whatsapp.com/684051319521343/?helpref=inline\\\" data-lnfb-mode=\\\"ie\\\">register your phone number\\u003C/a>. \\u003C/p>\\u003Ch3>Add contacts\\u003C/h3>\\u003Cp>You can sync your phone contacts with WhatsApp or add contacts directly to WhatsApp.\\u003C/p>\\u003Cp>Learn how to \\u003Ca href=\\\"https://faq.whatsapp.com/5472030609512325?helpref=inline\\\" data-lnfb-mode=\\\"ie\\\">add, edit, or delete a contact\\u003C/a>.\\u003C/p>\\u003Ch3>Linked devices\\u003C/h3>\\u003Cp>Once you set up WhatsApp on your phone, you can access your account on multiple devices by linking them to your phone. Learn how to \\u003Ca href=\\\"https://faq.whatsapp.com/1317564962315842?helpref=faq_content\\\" data-lnfb-mode=\\\"ie\\\">link a device\\u003C/a>.\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cdiv style=\\\"position:relative; overflow:hidden; width: 100\\u0025;padding-top: 56.25\\u0025;\\\">\\u003Ciframe src=\\\"https://faq.whatsapp.com/client_video/1272901340433571/?video_locale=en_US&amp;thumbnail_timestamp_ms=1000\\\" style=\\\"position:absolute; top:0; left:0; bottom:0; right:0; width:100\\u0025; height:100\\u0025;\\\" frameborder=\\\"0\\\" allowfullscreen=\\\"1\\\">\\u003C/iframe>\\u003C/div>\\u003Cp>Linked devices provide a reliable, secure way to access WhatsApp from other devices, including your desktop, browser, tablet, and wearables. You can link up to four devices at a time to your primary phone. \\u003C/p>\\u003Cp>\\u003Cb>Note:\\u003C/b> You must have an active WhatsApp account on your primary phone to continue using to continue using WhatsApp on your linked devices.\\u003C/p>\\u003Cp>Supported linked devices include:\\u003C/p>\\u003Cul>\\u003Cli>\\u003Ca href=\\\"https://www.whatsapp.com/download\\\" data-lnfb-mode=\\\"ie\\\">Windows\\u003C/a>\\u003C/li>\\u003Cli>\\u003Ca href=\\\"https://www.whatsapp.com/download\\\" data-lnfb-mode=\\\"ie\\\">Mac\\u003C/a>\\u003C/li>\\u003Cli>\\u003Ca href=\\\"https://faq.whatsapp.com/668538004658079?helpref=inline\\\" data-lnfb-mode=\\\"ie\\\">Web\\u003C/a>\\u003C/li>\\u003Cli>\\u003Ca href=\\\"https://faq.whatsapp.com/670052398160812/?helpref=inline\\\" data-lnfb-mode=\\\"ie\\\">Android tablet\\u003C/a>\\u003C/li>\\u003Cli>\\u003Ca href=\\\"https://faq.whatsapp.com/564431798835071/?helpref=inline\\\" data-lnfb-mode=\\\"ie\\\">WearOS\\u003C/a>\\u003C/li>\\u003Cli>\\u003Ca href=\\\"https://faq.whatsapp.com/1317564962315842?helpref=inline\\\" data-lnfb-mode=\\\"ie\\\">Companion Phones\\u003C/a>\\u003C/li>\\u003Cli>\\u003Ca href=\\\"https://www.meta.com/glasses\\\" target=\\\"_blank\\\" data-lnfb-mode=\\\"ie\\\">Ray-Ban Stories and Ray-Ban Meta\\u003C/a>\\u003C/li>\\u003Cli>\\u003Ca href=\\\"https://faq.whatsapp.com/1460738748095414?helpref=inline\\\" data-lnfb-mode=\\\"ie\\\">VR\\u003C/a>\\u003C/li>\\u003C/ul>\\u003Cp>Learn how to link a device \\u003Ca href=\\\"https://faq.whatsapp.com/1317564962315842?helpref=faq_content\\\" data-lnfb-mode=\\\"ie\\\">here\\u003C/a>.\\u003C/p>\\u003Cbr>\\u003Ch3>Related resources\\u003C/h3>\\u003Cul>\\u003Cli>\\u003Ca href=\\\"https://faq.whatsapp.com/378279804439436/?helpref=tc_about\\\" data-lnfb-mode=\\\"ie\\\">About linked devices\\u003C/a>\\u003C/li>\\u003Cli>\\u003Ca href=\\\"https://faq.whatsapp.com/673193694148537/?helpref=tc_about\\\" data-lnfb-mode=\\\"ie\\\">About disappearing messages\\u003C/a>\\u003C/li>\\u003Cli>\\u003Ca href=\\\"https://faq.whatsapp.com/3242937609289432/?helpref=tc_about\\\" data-lnfb-mode=\\\"ie\\\">How to create and invite into a group\\u003C/a>\\u003C/li>\\u003Cli>\\u003Ca href=\\\"https://faq.whatsapp.com/1153602608602452/?helpref=tc_about\\\" data-lnfb-mode=\\\"ie\\\">How to make a voice call\\u003C/a>\\u003C/li>\\u003Cli>\\u003Ca href=\\\"https://faq.whatsapp.com/1862285217468140/?helpref=tc_about\\\" data-lnfb-mode=\\\"ie\\\">How to make a video call\\u003C/a>\\u003C/li>\\u003C/ul>\\u003C/div>\\u003Cdiv class=\\\"_a0jc\\\">\\u003Cdiv class=\\\"_aini\\\">Does this answer your question?\\u003C/div>\\u003Cdiv class=\\\"_ainj\\\">\\u003Ca class=\\\"_aink\\\" href=\\\"https://faq.whatsapp.com/cli