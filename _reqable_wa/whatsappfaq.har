ent{border:0;box-sizing:border-box;display:block;font-size:0;height:0;line-height:0;outline:none;pointer-events:none;position:relative;text-decoration:none}\\u0040media (min-width: 1096px){.rich-text a.fragment{padding-top:121px;margin-top:-121px}}\\u0040media (min-width: 768px) and (max-width: 1095px){.rich-text a.fragment{padding-top:104px;margin-top:-104px}}\\u0040media (max-width: 767px){.rich-text a.fragment{padding-top:91px;margin-top:-91px}}.rich-text{font-size:14px;line-height:1.45}\\u0040media (min-width: 768px){.rich-text{font-size:16px;line-height:1.625;color:#5e5e5e}.rich-text.rich-text--large{font-size:18px;line-height:1.625}}\\u0040media (max-width: 767px){.rich-text{font-size:15px;line-height:1.5;color:#282828}}\\u0040media (min-width: 768px){.rich-text p,.rich-text ul,.rich-text ol{margin-bottom:31px}}\\u0040media (max-width: 767px){.rich-text p,.rich-text ul,.rich-text ol{margin-bottom:21px}}.rich-text sup{font-size:12px;vertical-align:top;display:inline;opacity:.8}.rich-text ol{list-style-type:decimal}html[lang=ar] .rich-text ol,.ar .rich-text ol{list-style-type:arabic-indic}.rich-text li p{margin-bottom:0}.rich-text ul,.rich-text ol{margin-left:31px}.rich-text ul{list-style-type:disc}.rich-text strong{font-weight:500}.rich-text code{word-break:break-word}.rich-text li strong,.rich-text p strong{color:#32373b}.rich-text a{color:#027eb5}.rich-text a:hover{text-decoration:underline}.rich-text table{border-collapse:collapse;margin-bottom:21px}.rich-text td,.rich-text th{vertical-align:top;padding:9px 20px 10px 12px;font-size:14px;line-height:21px}.rich-text td{border-bottom:1px solid #e5e5e5}.rich-text th{text-align:left;font-weight:400;color:#b0b0b0;border-bottom:3px solid #e5e5e5}.rich-text th b{color:#4e636d}.rich-text pre{width:100\\u0025;overflow:hidden;overflow-x:auto;font-size:14px;background-color:#f8f8f8;border-radius:4px;padding:12px 18px}.rich-text pre code{color:#333;background-color:transparent;padding:0;border-radius:0}.rich-text p code{font-size:15px;line-height:22px;display:inline-block;color:#32373b;background-color:#f5f5f5}.rich-text p strong code{color:#000}.rich-text td>em{color:#b0b0b0;font-style:normal}.rich-text h4{color:#2f434d;font-weight:500!important;margin-top:32px;margin-bottom:12px}.rich-text h1{font-size:38px;line-height:1.2;font-weight:300;color:#282828}.rich-text h2{margin-top:32px;margin-bottom:12px!important;font-size:26px;font-weight:400;line-height:1.2;color:#282828}.rich-text h2 a{display:block;visibility:hidden}\\u0040media (min-width: 768px) and (max-width: 1095px){.rich-text h2 a{height:81px;margin-top:-81px}}\\u0040media (min-width: 1096px){.rich-text h2 a{height:108px;margin-top:-108px}}\\u0040media (max-width: 767px){.rich-text h2 a{height:74px;margin-top:-74px}}.rich-text h3{padding-top:0!important;padding-bottom:0!important;margin-top:36px;margin-bottom:22px!important;font-size:22px;line-height:1.2;font-weight:400;color:#29c1aa}.rich-text h3 a{display:block;visibility:hidden}\\u0040media (min-width: 768px) and (max-width: 1095px){.rich-text h3 a{height:81px;margin-top:-81px}}\\u0040media (min-width: 1096px){.rich-text h3 a{height:108px;margin-top:-108px}}\\u0040media (max-width: 767px){.rich-text h3 a{height:74px;margin-top:-74px}}.rich-text h5{font-weight:500;font-size:17px;margin-bottom:22px;color:#2f434d}.rich-text hr{margin:18px 0!important}.rich-text pre.wrap{white-space:pre-wrap;white-space:-pre-wrap;word-wrap:break-word}.rich-text li{margin-bottom:10px}.rich-text li:last-of-type{margin-bottom:0}.rich-text ul li>p{text-indent:0!important;display:inline-block;vertical-align:top}.rich-text li>ul,.rich-text li>ol{margin-top:10px}\\u0040media (max-width: 319px){.rich-text ul,.rich-text ol{margin-left:20px}.rich-text p,.rich-text ul,.rich-text ol{margin-bottom:12px;word-break:break-word}.rich-text strong{font-weight:700}}.rich-text .data-search{margin-bottom:32px}.rich-text .ui-autocomplete{box-shadow:0 3px 6px #0006}.rich-text .data-search .title{margin-top:20px}.rich-text .data-search input{padding:6px 8px;border-radius:4px;border:1px solid #d9d9d9;box-shadow:inset 0 1px 1px #dedede}.rich-text .data-search .data{margin-top:20px}.rich-text .data-search .data .label{display:inline-block;width:180px;margin-bottom:8px}.rich-text .data-search .data .value{display:inline-block;width:240px;font-weight:700;color:#2f434d}.rich-text .data-search .value-single{font-weight:700;color:#49b95c}.rich-text .data-search .value-single .error{color:#f26a5f}.rich-text #nokia_search .title{font-size:100\\u0025}.rich-text li p{display:block;width:100\\u0025}.rich-text .icon-large{max-width:34px!important;max-height:34px!important;vertical-align:middle;margin-left:2px}.rich-text .icon{max-width:25px!important;max-height:25px!important;vertical-align:middle;margin-left:2px}.rich-text .icon-small{max-width:20px!important;max-height:20px!important;vertical-align:middle;margin-left:2px}.rich-text .margin-cms{margin-left:4px}.rich-text p:empty{display:none}.rich-text .currency{border-bottom:1px dotted #999;cursor:pointer;color:#2f434d}.rich-text #currency-tip{position:absolute;top:0;left:0;width:180px;padding:15px 20px;font-size:13px;line-height:18px;border-radius:4px;box-shadow:0 3px 6px #0006;z-index:55557!important;background-color:#fff}.rich-text .actions{margin-top:32px!important;margin-bottom:32px!important}.rich-text a.button{text-decoration:none!important}\\u0040media (min-width: 768px){.rich-text img{display:inline-block!important;padding:0;vertical-align:middle;max-width:276px}.rich-text img.small{max-width:254px!important}.rich-text img.medium{max-width:378px!important}.rich-text img.large{max-width:480px!important}.rich-text img.full{max-width:100\\u0025!important}.rich-text img.center{display:block!important;margin:0 auto}.rich-text img.half{max-width:354px;max-height:none!important;margin-left:12px;float:left}.rich-text img.third{max-width:250px!important;margin-left:12px;float:left}.rich-text img.third:first-child,.rich-text img.half:first-child{margin-left:0}.rich-text img.half:last-of-type,.rich-text img.third:last-of-type{float:none}.rich-text img.half:last-of-type:after,.rich-text img.third:last-of-type:after{content:\\\".\\\";display:block;height:0;clear:both;visibility:hidden}}\\u0040media (max-width: 767px){.rich-text img{max-width:100\\u0025}}.rich-text-section+.rich-text-section{margin-top:75px}.rich-text-section_title h1,.rich-text-section_title h2,.rich-text-section_title h3,.rich-text-section_title h4,.rich-text-section_title h5,.rich-text-section_title h6{margin-bottom:.8em!important}\\nimg{max-width:280px}.small{max-width:240px}.medium{max-width:320px}.large{max-width:360px}\\u003C/style>\\u003C/head>\\u003Cbody dir=\\\"ltr\\\" class=\\\"_8isn _agix x1 Locale_en_US\\\">\\u003Cdiv class=\\\"_8isn\\\">\\u003Cdiv class=\\\"_8iso\\\">\\u003Cdiv class=\\\"_8iu9\\\">\\u003Cdiv class=\\\"rich-text\\\">\\u003Ch1>About disappearing messages\\u003C/h1>\\u003Cp style=\\\"text-align:center\\\">\\u003Cimg class=\\\"full _-q6\\\" id=\\\"\\\" src=\\\"https://scontent.whatsapp.net/v/t39.8562-34/420080500_913550250116136_4560273446204165335_n.png?ccb=1-7&amp;_nc_sid=73b08c&amp;_nc_ohc=4_xqPrcQR44Q7kNvwEQhqSR&amp;_nc_oc=AdqL_w5CMHwqy9BvuHgki3qi-8GVxgxhBzyEJTsZPxfYwub_dez7luAFyckqTPgijF4&amp;_nc_zt=3&amp;_nc_ht=scontent.whatsapp.net&amp;_nc_gid=VxigPuS8s9jypLR0OXmN6Q&amp;_nc_ss=7839b&amp;oh=01_Q5Aa4wF9vepN1FoxOZHFGZhUgj4nzDhhzcibznE3B351zvoOHw&amp;oe=6A482339\\\" style=\\\"\\\">\\u003C/p>\\u003Cp>Disappearing messages is an optional feature you can turn on for more privacy. \\u003C/p>\\u003Cp>You can set messages to disappear 24 hours, 7 days, or 90 days after they&rsquo;re sent unless that message is kept. The duration you choose only affects new messages in the chat, not messages you&rsquo;ve already sent or received. \\u003C/p>\\u003Ch3>How to use disappearing messages \\u003C/h3>\\u003Cp>You can choose to turn disappearing messages on for all chats or select specific chats. In individual chats, either you or the person you&rsquo;re messaging can turn disappearing messages on or off. Learn how to turn disappearing messages on or off in this \\u003Ca href=\\\"https://faq.whatsapp.com/5590979194321336\\\" data-lnfb-mode=\\\"ie\\\">help article\\u003C/a>.\\u003C/p>\\u003Cp>Anyone can turn disappearing messages on or off in group chats by default. But, group admins can change group settings to allow only admins to do this. Learn how to turn disappearing messages on or off in a group in this \\u003Ca href=\\\"https://faq.whatsapp.com/515705483748188\\\" data-lnfb-mode=\\\"ie\\\">help article\\u003C/a>.\\u003C/p>\\u003Cp>You can set disappearing messages as default for new individual chats by tapping \\u003Cb>Settings\\u003C/b> &gt; \\u003Cb>Privacy\\u003C/b> &gt; \\u003Cb>Default message timer\\u003C/b> and selecting a duration. \\u003C/p>\\u003Cp>\\u003Cb>Note\\u003C/b>:\\u003C/p>\\u003Cul>\\u003Cli>\\u003Cb>You can set messages to disappear after 24 hours, 7 days, or 90 days.\\u003C/b>\\u003C/li>\\u003Cli>Disappearing messages disappear for both senders and recipients, including messages you send to yourself. \\u003C/li>\\u003Cli>After the disappearing messages setting is enabled for a group chat, new messages will disappear. Messages sent before the settings change are unaffected. \\u003C/li>\\u003Cli>If you don&rsquo;t open WhatsApp within the time you set messages to disappear, the message will disappear from the chat. But the message preview might still be displayed until the person you&rsquo;re messaging opens WhatsApp. \\u003C/li>\\u003Cli>If a disappearing message is forwarded to a chat with disappearing messages off, the message won&rsquo;t disappear in the forwarded chat. \\u003C/li>\\u003Cli>When you reply to a message on WhatsApp, the original message is quoted in your response. If you have disappearing messages turned on, the quoted message might still be visible in the chat after the duration limit has passed. \\u003C/li>\\u003Cli>If a user creates a backup before a message disappears, the disappeared message will be included in the backup. Disappearing messages will be deleted when a user restores from a backup. \\u003C/li>\\u003Cli>Disappearing messages aren&rsquo;t available in certain countries for payment or order-related messages. You can still delete these messages from your own chat history individually. \\u003C/li>\\u003C/ul>\\u003Ch3>About kept messages\\u003C/h3>\\u003Cp>Anyone in a group chat can keep disappearing messages to stop them from disappearing as long as the set duration time hasn&rsquo;t passed. \\u003C/p>\\u003Cul>\\u003Cli>A kept message will be visible to everyone in the conversation and won&rsquo;t disappear when its duration expires.\\u003C/li>\\u003Cli>The message sender has ultimate control over who can keep it. If someone keeps a message you've sent, you'll get a notification. If you decide to unkeep the message, no one else in the chat can keep it again.\\u003C/li>\\u003Cli>You&rsquo;ll have approximately 30 days to unkeep a message from the time it was kept.\\u003C/li>\\u003C/ul>\\u003Cp>Learn more about \\u003Ca href=\\\"https://faq.whatsapp.com/728928448599090\\\" data-lnfb-mode=\\\"ie\\\">kept messages\\u003C/a>. \\u003C/p>\\u003Ch3>Media in disappearing messages\\u003C/h3>\\u003Cp>By default, any media you download in WhatsApp will be automatically saved to your photos. But if disappearing messages are turned on, media sent in a chat will disappear and won't be saved to your photos. \\u003C/p>\\u003C/div>\\u003Cdiv class=\\\"_a0jc\\\">\\u003Cdiv class=\\\"_aini\\\">Does this answer your question?\\u003C/div>\\u003Cdiv class=\\\"_ainj\\\">\\u003Ca class=\\\"_aink\\\" href=\\\"https://faq.whatsapp.com/client_search_feedback/?enc=AfZP63gsRcsjXO_xhLoFsyhmKkkZm8M5KUTeb7n7Tvz2aDgj1h0eT4AnYlkWWuqV5s5FreGMUwHL8Kw-dXNfheub3PJbDooINSqODBIsaFY79hLSGcUx-46HGxWO2PxG38zTq4bj8HfzJtrPCVuFVi3f2ZE8O5rhhg4eucnPe8QTJA\\\" data-lnfb-mode=\\\"ie\\\">Yes\\u003C/a>\\u003Ca class=\\\"_aink\\\" href=\\\"https://faq.whatsapp.com/client_search_feedback/?enc=AfYca2QV_hffUAKCLVh4lBMfCF_3nolVs-Z3eJpuSwx8P_zdCFVCKZXdku7v7JulO58gMOYpoAECU86o8ZKpWQS0xuKu5WQEqYr_yeL4XqO5lhHNzBT2hPEAz5zXUU_Ka3xAt3vwDrKh-3CKC0uIJD9aTOm9V1UEiC6CoJy9JjEb\\\" data-lnfb-mode=\\\"ie\\\">No\\u003C/a>\\u003C/div>\\u003Cimg src=\\\"https://faq.whatsapp.com/client_search_feedback_pixel.png?enc=AfYffXBDiTy9He8RWAE8-0zvf3smefa4PHBHMOMcOGfLTPVSJu1bYvh3wnfSBZGxgMj6OZAg3JfgKMjlSPFnyP7lwua3ErL7K-UiQoj8NssKmir5Li6f269VNRMt0NHGMVmUV9enlfx2GuFTdx0RB4wHyYzK_Uxs-QJChV-V1x4G\\\" alt=\\\"\\\">\\u003C/div>\\u003C/div>\\u003C/div>\\u003C/div>\\u003C/body>\\u003C/html>\\n\"},{\"title\":\"About advanced chat privacy\",\"lang\":\"en\",\"url\":\"https://faq.whatsapp.com/715385484388016/?cms_id=/715385484388016\",\"id\":\"715385484388016\",\"description\":\"\\u003C!DOCTYPE html>\\n\\u003Chtml lang=\\\"en\\\" id=\\\"facebook\\\" class=\\\"no_js\\\">\\n\\u003Chead>\\u003Cmeta charset=\\\"utf-8\\\">\\u003Cmeta name=\\\"referrer\\\" content=\\\"default\\\" id=\\\"meta_referrer\\\">\\u003Cscript nonce=\\\"LpL9I3tV\\\">__DEV__=0;\\u003C/script>\\u003Ctitle>Facebook\\u003C/title>\\u003Cmeta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1, user-scalable=no\\\">\\u003Cstyle>html{touch-action:manipulation}body{background:#fff;color:#1c1e21;direction:ltr;line-height:1.34;margin:0;padding:0;unicode-bidi:embed}body,button,input,label,select,td,textarea{font-family:Helvetica,Arial,sans-serif;font-size:12px}h1,h2,h3,h4,h5,h6{color:#1c1e21;font-size:13px;font-weight:600;margin:0;padding:0}h1{font-size:14px}h4,h5,h6{font-size:12px}p{margin:1em 0}b,strong{font-weight:600}a{color:#385898;cursor:pointer;text-decoration:none}button{margin:0}a:hover{text-decoration:underline}img{border:0px}td,td.label{text-align:left}dd{color:#000}dt{color:#606770}ul{list-style-type:none;margin:0;padding:0}abbr{border-bottom:none;text-decoration:none}hr{background:#dadde1;border-width:0;color:#dadde1;height:1px}\\n._8isn{font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen,Ubuntu,Cantarell,Open Sans,Helvetica Neue,sans-serif;margin:0;padding:0;text-rendering:optimizeLegibility}._8isn p,._8isn ul,._8isn li,._8isn ol{margin:0;padding:0}._a0or{padding:32px;text-align:center}._8iso{padding:0 25px 0 32px}._8iu9 .rich-text h1{font-size:26px;margin:36px 0 22px}._8iu9 .rich-text h3{font-size:21px}._8iu9 .rich-text h5{margin:22px 0 12px}._8iu9 ul ul,._8iu9 ol ul{list-style-type:circle}._8iu9 p,._8iu9 ul,._8iu9 ol{margin:16px 0}._8isn.platform--android h1,._8isn.platform--android h2,._8isn.platform--android h3,._8isn.platform--android h4,._8isn.platform--android h5,._8isn.platform--android h6{color:#1dbea5}._8isn.platform--iphone ._8iso ._8iu9{background-color:#f9f9f9}._8isn.platform--iphone ._8iso{background-color:#fff;border-bottom:1px solid #e0dce0}._8isn.platform--iphone ._8iso ._8iu9 h1,._8isn.platform--iphone ._8iso ._8iu9 h2,._8isn.platform--iphone ._8iso ._8iu9 h3,._8isn.platform--iphone ._8iso ._8iu9 h4,._8isn.platform--iphone ._8iso ._8iu9 h5,._8isn.platform--iphone ._8iso ._8iu9 h6{color:#0c0c0c}._9vtq ._8iso{padding:0}._9vtq ._8iu9{padding:0 25px 60px 32px}._9vtq ._9vts{align-items:center;bottom:0;box-sizing:border-box;display:flex;height:60px;justify-content:center;margin:0;padding:8px 16px;position:fixed;width:100\\u0025}._9vtq ._9vtt{background-color:#1daa61;border-radius:16px;box-sizing:border-box;color:#fff;display:block;font-size:15px;font-weight:700;height:44px;line-height:1.5;padding:12px 18px;text-align:center;text-decoration:none;width:100\\u0025}._9vtq ul,._9vtq ol{margin:0 0 21px 31px;padding:0}._9vtq li{margin-bottom:10px}._9vtq li:last-of-type{margin-bottom:0}._9vtq p{margin-bottom:21px}\\u0040media (max-width: 768px){._a0jc ul{margin-left:0}._a0jc ul li a{display:block;font-size:15px;padding:16px 24px}}div._a0sc{background-color:#f6f7f9;padding:30px}\\u0040media (min-width: 768px){._a0sd{width:85\\u0025}._a0se{margin-top:10\\u0025}}._a0jc{border-bottom:1px solid #F0F4F9;border-top:1px solid #F0F4F9;text-align:center}._aini{color:#5e5e5e;display:block;font-size:16px;margin-bottom:28px;margin-top:28px}._ainj{margin-bottom:32px}._ainj ._aink:first-child{margin-right:16px}._aink{background:#fff;border:2px solid #77D7C8;border-radius:40px;color:#128c7e;display:inline-block;font-size:16px;font-weight:500;line-height:120\\u0025;padding:16px 32px;text-align:center}\\u0040media (min-width: 768px){._ainj{margin-bottom:0}._a0jc{align-items:center;border-top:1px solid #F0F4F9;display:flex;text-align:left}}\\n.rich-text a.fragment{border:0;box-sizing:border-box;display:block;font-size:0;height:0;line-height:0;outline:none;pointer-events:none;position:relative;text-decoration:none}\\u0040media (min-width: 1096px){.rich-text a.fragment{padding-top:121px;margin-top:-121px}}\\u0040media (min-width: 768px) and (max-width: 1095px){.rich-text a.fragment{padding-top:104px;margin-top:-104px}}\\u0040media (max-width: 767px){.rich-text a.fragment{padding-top:91px;margin-top:-91px}}.rich-text{font-size:14px;line-height:1.45}\\u0040media (min-width: 768px){.rich-text{font-size:16px;line-height:1.625;color:#5e5e5e}.rich-text.rich-text--large{font-size:18px;line-height:1.625}}\\u0040media (max-width: 767px){.rich-text{font-size:15px;line-height:1.5;color:#282828}}\\u0040media (min-width: 768px){.rich-text p,.rich-text ul,.rich-text ol{margin-bottom:31px}}\\u0040media (max-width: 767px){.rich-text p,.rich-text ul,.rich-text ol{margin-bottom:21px}}.rich-text sup{font-size:12px;vertical-align:top;display:inline;opacity:.8}.rich-text ol{list-style-type:decimal}html[lang=ar] .rich-text ol,.ar .rich-text ol{list-style-type:arabic-indic}.rich-text li p{margin-bottom:0}.rich-text ul,.rich-text ol{margin-left:31px}.rich-text ul{list-style-type:disc}.rich-text strong{font-weight:500}.rich-text code{word-break:break-word}.rich-text li strong,.rich-text p strong{color:#32373b}.rich-text a{color:#027eb5}.rich-text a:hover{text-decoration:underline}.rich-text table{border-collapse:collapse;margin-bottom:21px}.rich-text td,.rich-text th{vertical-align:top;padding:9px 20px 10px 12px;font-size:14px;line-height:21px}.rich-text td{border-bottom:1px solid #e5e5e5}.rich-text th{text-align:left;font-weight:400;color:#b0b0b0;border-bottom:3px solid #e5e5e5}.rich-text th b{color:#4e636d}.rich-text pre{width:100\\u0025;overflow:hidden;overflow-x:auto;font-size:14px;background-color:#f8f8f8;border-radius:4px;padding:12px 18px}.rich-text pre code{color:#333;background-color:transparent;padding:0;border-radius:0}.rich-text p code{font-size:15px;line-height:22px;display:inline-block;color:#32373b;background-color:#f5f5f5}.rich-text p strong code{color:#000}.rich-text td>em{color:#b0b0b0;font-style:normal}.rich-text h4{color:#2f434d;font-weight:500!important;margin-top:32px;margin-bottom:12px}.rich-text h1{font-size:38px;line-height:1.2;font-weight:300;color:#282828}.rich-text h2{margin-top:32px;margin-bottom:12px!important;font-size:26px;font-weight:400;line-height:1.2;color:#282828}.rich-text h2 a{display:block;visibility:hidden}\\u0040media (min-width: 768px) and (max-width: 1095px){.rich-text h2 a{height:81px;margin-top:-81px}}\\u0040media (min-width: 1096px){.rich-text h2 a{height:108px;margin-top:-108px}}\\u0040media (max-width: 767px){.rich-text h2 a{height:74px;margin-top:-74px}}.rich-text h3{padding-top:0!important;padding-bottom:0!important;margin-top:36px;margin-bottom:22px!important;font-size:22px;line-height:1.2;font-weight:400;color:#29c1aa}.rich-text h3 a{display:block;visibility:hidden}\\u0040media (min-width: 768px) and (max-width: 1095px){.rich-text h3 a{height:81px;margin-top:-81px}}\\u0040media (min-width: 1096px){.rich-text h3 a{height:108px;margin-top:-108px}}\\u0040media (max-width: 767px){.rich-text h3 a{height:74px;margin-top:-74px}}.rich-text h5{font-weight:500;font-size:17px;margin-bottom:22px;color:#2f434d}.rich-text hr{margin:18px 0!important}.rich-text pre.wrap{white-space:pre-wrap;white-space:-pre-wrap;word-wrap:break-word}.rich-text li{margin-bottom:10px}.rich-text li:last-of-type{margin-bottom:0}.rich-text ul li>p{text-indent:0!important;display:inline-block;vertical-align:top}.rich-text li>ul,.rich-text li>ol{margin-top:10px}\\u0040media (max-width: 319px){.rich-text ul,.rich-text ol{margin-left:20px}.rich-text p,.rich-text ul,.rich-text ol{margin-bottom:12px;word-break:break-word}.rich-text strong{font-weight:700}}.rich-text .data-search{margin-bottom:32px}.rich-text .ui-autocomplete{box-shadow:0 3px 6px #0006}.rich-text .data-search .title{margin-top:20px}.rich-text .data-search input{padding:6px 8px;border-radius:4px;border:1px solid #d9d9d9;box-shadow:inset 0 1px 1px #dedede}.rich-text .data-search .data{margin-top:20px}.rich-text .data-search .data .label{display:inline-block;width:180px;margin-bottom:8px}.rich-text .data-search .data .value{display:inline-block;width:240px;font-weight:700;color:#2f434d}.rich-text .data-search .value-single{font-weight:700;color:#49b95c}.rich-text .data-search .value-single .error{color:#f26a5f}.rich-text #nokia_search .title{font-size:100\\u0025}.rich-text li p{display:block;width:100\\u0025}.rich-text .icon-large{max-width:34px!important;max-height:34px!important;vertical-align:middle;margin-left:2px}.rich-text .icon{max-width:25px!important;max-height:25px!important;vertical-align:middle;margin-left:2px}.rich-text .icon-small{max-width:20px!important;max-height:20px!important;vertical-align:middle;margin-left:2px}.rich-text .margin-cms{margin-left:4px}.rich-text p:empty{display:none}.rich-text .currency{border-bottom:1px dotted #999;cursor:pointer;color:#2f434d}.rich-text #currency-tip{position:absolute;top:0;left:0;width:180px;padding:15px 20px;font-size:13px;line-height:18px;border-radius:4px;box-shadow:0 3px 6px #0006;z-index:55557!important;background-color:#fff}.rich-text .actions{margin-top:32px!important;margin-bottom:32px!important}.rich-text a.button{text-decoration:none!important}\\u0040media (min-width: 768px){.rich-text img{display:inline-block!important;padding:0;vertical-align:middle;max-width:276px}.rich-text img.small{max-width:254px!important}.rich-text img.medium{max-width:378px!important}.rich-text img.large{max-width:480px!important}.rich-text img.full{max-width:100\\u0025!important}.rich-text img.center{display:block!important;margin:0 auto}.rich-text img.half{max-width:354px;max-height:none!important;margin-left:12px;float:left}.rich-text img.third{max-width:250px!important;margin-left:12px;float:left}.rich-text img.third:first-child,.rich-text img.half:first-child{margin-left:0}.rich-text img.half:last-of-type,.rich-text img.third:last-of-type{float:none}.rich-text img.half:last-of-type:after,.rich-text img.third:last-of-type:after{content:\\\".\\\";display:block;height:0;clear:both;visibility:hidden}}\\u0040media (max-width: 767px){.rich-text img{max-width:100\\u0025}}.rich-text-section+.rich-text-section{margin-top:75px}.rich-text-section_title h1,.rich-text-section_title h2,.rich-text-section_title h3,.rich-text-section_title h4,.rich-text-section_title h5,.rich-text-section_title h6{margin-bottom:.8em!important}\\nimg{max-width:280px}.small{max-width:240px}.medium{max-width:320px}.large{max-width:360px}\\u003C/style>\\u003C/head>\\u003Cbody dir=\\\"ltr\\\" class=\\\"_8isn _agix x1 Locale_en_US\\\">\\u003Cdiv class=\\\"_8isn\\\">\\u003Cdiv class=\\\"_8iso\\\">\\u003Cdiv class=\\\"_8iu9\\\">\\u003Cdiv class=\\\"rich-text\\\">\\u003Ch1>About advanced chat privacy\\u003C/h1>\\u003Cp>You can limit how other users can share your messages and media outside of WhatsApp. In group chats, group admins can enable Advanced Chat Privacy. In individual chats, either participant can enable Advanced Chat Privacy. When \\u003Cb>Advanced chat privacy\\u003C/b> is enabled for a chat, people in the chat: \\u003C/p>\\u003Cul>\\u003Cli>Can&rsquo;t save media to their device gallery automatically.\\u003C/li>\\u003Cli>Can't ask Meta AI to answer questions, or to create images or summaries in this chat.\\u003C/li>\\u003Cli>Can&rsquo;t export the chat.\\u003C/li>\\u003C/ul>\\u003Cp>Participants in the chat must enable \\u003Cb>Advanced chat privacy\\u003C/b> for each individual or group chat you want to apply this setting to. Once it&rsquo;s turned on, \\u003Cb>Advanced chat privacy\\u003C/b> applies to all messages in the chat. In group chats, group admins can enable Advanced Chat Privacy. In individual chats, either participant can enable Advanced Chat Privacy.\\u003C/p>\\u003Cblockquote>\\u003Cp>\\u003Cb>Note\\u003C/b>: All chats are private by default. Your personal messages are always protected with end-to-end encryption.\\u003C/p>\\u003Cp>Meta AI can&rsquo;t access your chats. It can only read the messages people choose to send it, nothing else. This is true whether Advanced chat privacy is on or off. \\u003C/p>\\u003C/blockquote>\\u003Ch3>Enable or disable advanced chat privacy for individual chats\\u003C/h3>\\u003Cp>Anyone in the chat can turn this setting on or off.\\u003C/p>\\u003Col>\\u003Cli>Tap the chat you want to edit. \\u003C/li>\\u003Cli>Tap \\u003Cinline-margin>\\u003C/inline-margin>\\u003Cimg class=\\\"img\\\" src=\\\"https://static.xx.fbcdn.net/assets/?set=whatsapp_help_article_assets&amp;name=android-more&amp;density=1\\\" width=\\\"25\\\" height=\\\"25\\\" alt=\\\" More (three vertical dots)\\\"> &gt; \\u003Cb>View contact\\u003C/b> &gt; \\u003Cb>Advanced chat privacy\\u003C/b>. \\u003C/li>\\u003Cli>Turn on or off \\u003Cb>Advanced chat privacy\\u003C/b>.\\u003C/li>\\u003C/ol>\\u003Ch3>Enable or disable advanced chat privacy for groups\\u003C/h3>\\u003Cp>This setting applies to every member of the group. Group admins can update this setting.\\u003C/p>\\u003Col>\\u003Cli>Tap the chat you want to edit. \\u003C/li>\\u003Cli>Tap \\u003Cinline-margin>\\u003C/inline-margin>\\u003Cimg class=\\\"img\\\" src=\\\"https://static.xx.fbcdn.net/assets/?set=whatsapp_help_article_assets&amp;name=android-more&amp;density=1\\\" width=\\\"25\\\" height=\\\"25\\\" alt=\\\" More (three vertical dots)\\\"> &gt; \\u003Cb>Group info\\u003C/b> &gt; \\u003Cb>Group permissions\\u003C/b>. \\u003C/li>\\u003Cli>Turn on \\u003Cb>Edit group settings\\u003C/b>.\\u003C/li>\\u003Cli>Go back to the Group info page and tap \\u003Cb>Advanced chat privacy\\u003C/b>.\\u003C/li>\\u003Cli>Turn on or off \\u003Cb>Advanced chat privacy\\u003C/b>.\\u003C/li>\\u003C/ol>\\u003Cp>\\u003Cb>Note\\u003C/b>: \\u003C/p>\\u003Cli>Users who aren&rsquo;t on the latest version of WhatsApp may still be able to share chats outside of WhatsApp, like auto-downloading media. When enabling this feature, you won&rsquo;t be notified if someone in the chat isn&rsquo;t on the latest version of WhatsApp. \\u003C/li>\\u003Cli>Advanced chat privacy isn&rsquo;t available in chats with businesses that choose to use WhatsApp's parent company, Meta, to securely store messages and respond to customers on its behalf.  Learn more in \\u003Ca href=\\\"https://faq.whatsapp.com/1148840052398648?helpref=inline\\\" data-lnfb-mode=\\\"ie\\\">this article\\u003C/a>.\\u003C/li>\\u003Ch3>Related resources\\u003C/h3>\\u003Cul>\\u003Cli>How to \\u003Ca href=\\\"https://faq.whatsapp.com/3307102709559968?helpref=rr\\\" data-lnfb-mode=\\\"ie\\\">change your privacy settings\\u003C/a>\\u003C/li>\\u003Cli>How to \\u003Ca href=\\\"https://faq.whatsapp.com/1131457590844955?helpref=faq_content\\\" data-lnfb-mode=\\\"ie\\\">change group privacy settings\\u003C/a>\\u003C/li>\\u003Cli>About \\u003Ca href=\\\"https://faq.whatsapp.com/2257017191175152?helpref=rr\\\" data-lnfb-mode=\\\"ie\\\">Meta AI\\u003C/a>\\u003C/li>\\u003C/ul>\\u003C/div>\\u003Cdiv class=\\\"_a0jc\\\">\\u003Cdiv class=\\\"_aini\\\">Does this answer your question?\\u003C/div>\\u003Cdiv class=\\\"_ainj\\\">\\u003Ca class=\\\"_aink\\\" href=\\\"https://faq.whatsapp.com/client_search_feedback/?enc=AfZ3OLmKU1dgN_cvC6dHsr-WXAnODAmzC7ZbjqTeOYgTMC7bMmdJALFFbi5FHlRhMsJ0Wz1RUCoFslsHjo6tefUbGpto4FTvV1ySRI1fsEQ95xqpNffMp5sIr3Mg8hs0WiWeRqcy9zPaY3aEVGqe2x2NjIkbytYfCYL7BhpkdFvFcA\\\" data-lnfb-mode=\\\"ie\\\">Yes\\u003C/a>\\u003Ca class=\\\"_aink\\\" href=\\\"https://faq.whatsapp.com/client_search_feedback/?enc=Afa_5JhmWe2j3HYCbFk0G8VhwfSe0AdqLCsMiYy9iVMQ4osKuFC9CD4VF9pXh-cWM2_KIi_eRWDgqioHH8gmM_nVxjy596RKxBP0fOKdDqS8K1FR0J5ao2tmyS6gnGqm86WyawRiMW8rnnTDCNkIelbsJqEasXfeISh2cIBaAJgO\\\" data-lnfb-mode=\\\"ie\\\">No\\u003C/a>\\u003C/div>\\u003Cimg src=\\\"https://faq.whatsapp.com/client_search_feedback_pixel.png?enc=AfaQTbQMQH-CTx_YhqZUGbeTirfSRASeyKYs0rAWi9O_rKTmiSTz82ZHrcLxQGar0zJpKq_wLZSTZ3yrGRB0l8i86vwF8klsBZ7kYg5tHUA1y2ZKuAN6-kNMKRsWxUqfDzmnTI4BhBLzFwYKBfpTiboOI37Hva-jrcWjqW-ths5-\\\" alt=\\\"\\\">\\u003C/div>\\u003C/div>\\u003C/div>\\u003C/div>\\u003C/body>\\u003C/html>\\n\"},{\"title\":\"About unofficial apps\",\"lang\":\"en\",\"url\":\"https://faq.whatsapp.com/1217634902127718/?cms_id=/1217634902127718\",\"id\":\"1217634902127718\",\"description\":\"\\u003C!DOCTYPE html>\\n\\u003Chtml lang=\\\"en\\\" id=\\\"facebook\\\" class=\\\"no_js\\\">\\n\\u003Chead>\\u003Cmeta charset=\\\"utf-8\\\">\\u003Cmeta name=\\\"referrer\\\" content=\\\"default\\\" id=\\\"meta_referrer\\\">\\u003Cscript nonce=\\\"LpL9I3tV\\\">__DEV__=0;\\u003C/script>\\u003Ctitle>Facebook\\u003C/title>\\u003Cmeta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1, user-scalable=no\\\">\\u003Cstyle>html{touch-action:manipulation}body{background:#fff;color:#1c1e21;direction:ltr;line-height:1.34;margin:0;padding:0;unicode-bidi:embed}body,button,input,label,select,td,textarea{font-family:Helvetica,Arial,sans-serif;font-size:12px}h1,h2,h3,h4,h5,h6{color:#1c1e21;font-size:13px;font-weight:600;margin:0;padding:0}h1{font-size:14px}h4,h5,h6{font-size:12px}p{margin:1em 0}b,strong{font-weight:600}a{color:#385898;cursor:pointer;text-decoration:none}button{margin:0}a:hover{text-decoration:underline}img{border:0px}td,td.label{text-align:left}dd{color:#000