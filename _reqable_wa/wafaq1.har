-width: 767px){.rich-text a.fragment{padding-top:91px;margin-top:-91px}}.rich-text{font-size:14px;line-height:1.45}\\u0040media (min-width: 768px){.rich-text{font-size:16px;line-height:1.625;color:#5e5e5e}.rich-text.rich-text--large{font-size:18px;line-height:1.625}}\\u0040media (max-width: 767px){.rich-text{font-size:15px;line-height:1.5;color:#282828}}\\u0040media (min-width: 768px){.rich-text p,.rich-text ul,.rich-text ol{margin-bottom:31px}}\\u0040media (max-width: 767px){.rich-text p,.rich-text ul,.rich-text ol{margin-bottom:21px}}.rich-text sup{font-size:12px;vertical-align:top;display:inline;opacity:.8}.rich-text ol{list-style-type:decimal}html[lang=ar] .rich-text ol,.ar .rich-text ol{list-style-type:arabic-indic}.rich-text li p{margin-bottom:0}.rich-text ul,.rich-text ol{margin-left:31px}.rich-text ul{list-style-type:disc}.rich-text strong{font-weight:500}.rich-text code{word-break:break-word}.rich-text li strong,.rich-text p strong{color:#32373b}.rich-text a{color:#027eb5}.rich-text a:hover{text-decoration:underline}.rich-text table{border-collapse:collapse;margin-bottom:21px}.rich-text td,.rich-text th{vertical-align:top;padding:9px 20px 10px 12px;font-size:14px;line-height:21px}.rich-text td{border-bottom:1px solid #e5e5e5}.rich-text th{text-align:left;font-weight:400;color:#b0b0b0;border-bottom:3px solid #e5e5e5}.rich-text th b{color:#4e636d}.rich-text pre{width:100\\u0025;overflow:hidden;overflow-x:auto;font-size:14px;background-color:#f8f8f8;border-radius:4px;padding:12px 18px}.rich-text pre code{color:#333;background-color:transparent;padding:0;border-radius:0}.rich-text p code{font-size:15px;line-height:22px;display:inline-block;color:#32373b;background-color:#f5f5f5}.rich-text p strong code{color:#000}.rich-text td>em{color:#b0b0b0;font-style:normal}.rich-text h4{color:#2f434d;font-weight:500!important;margin-top:32px;margin-bottom:12px}.rich-text h1{font-size:38px;line-height:1.2;font-weight:300;color:#282828}.rich-text h2{margin-top:32px;margin-bottom:12px!important;font-size:26px;font-weight:400;line-height:1.2;color:#282828}.rich-text h2 a{display:block;visibility:hidden}\\u0040media (min-width: 768px) and (max-width: 1095px){.rich-text h2 a{height:81px;margin-top:-81px}}\\u0040media (min-width: 1096px){.rich-text h2 a{height:108px;margin-top:-108px}}\\u0040media (max-width: 767px){.rich-text h2 a{height:74px;margin-top:-74px}}.rich-text h3{padding-top:0!important;padding-bottom:0!important;margin-top:36px;margin-bottom:22px!important;font-size:22px;line-height:1.2;font-weight:400;color:#29c1aa}.rich-text h3 a{display:block;visibility:hidden}\\u0040media (min-width: 768px) and (max-width: 1095px){.rich-text h3 a{height:81px;margin-top:-81px}}\\u0040media (min-width: 1096px){.rich-text h3 a{height:108px;margin-top:-108px}}\\u0040media (max-width: 767px){.rich-text h3 a{height:74px;margin-top:-74px}}.rich-text h5{font-weight:500;font-size:17px;margin-bottom:22px;color:#2f434d}.rich-text hr{margin:18px 0!important}.rich-text pre.wrap{white-space:pre-wrap;white-space:-pre-wrap;word-wrap:break-word}.rich-text li{margin-bottom:10px}.rich-text li:last-of-type{margin-bottom:0}.rich-text ul li>p{text-indent:0!important;display:inline-block;vertical-align:top}.rich-text li>ul,.rich-text li>ol{margin-top:10px}\\u0040media (max-width: 319px){.rich-text ul,.rich-text ol{margin-left:20px}.rich-text p,.rich-text ul,.rich-text ol{margin-bottom:12px;word-break:break-word}.rich-text strong{font-weight:700}}.rich-text .data-search{margin-bottom:32px}.rich-text .ui-autocomplete{box-shadow:0 3px 6px #0006}.rich-text .data-search .title{margin-top:20px}.rich-text .data-search input{padding:6px 8px;border-radius:4px;border:1px solid #d9d9d9;box-shadow:inset 0 1px 1px #dedede}.rich-text .data-search .data{margin-top:20px}.rich-text .data-search .data .label{display:inline-block;width:180px;margin-bottom:8px}.rich-text .data-search .data .value{display:inline-block;width:240px;font-weight:700;color:#2f434d}.rich-text .data-search .value-single{font-weight:700;color:#49b95c}.rich-text .data-search .value-single .error{color:#f26a5f}.rich-text #nokia_search .title{font-size:100\\u0025}.rich-text li p{display:block;width:100\\u0025}.rich-text .icon-large{max-width:34px!important;max-height:34px!important;vertical-align:middle;margin-left:2px}.rich-text .icon{max-width:25px!important;max-height:25px!important;vertical-align:middle;margin-left:2px}.rich-text .icon-small{max-width:20px!important;max-height:20px!important;vertical-align:middle;margin-left:2px}.rich-text .margin-cms{margin-left:4px}.rich-text p:empty{display:none}.rich-text .currency{border-bottom:1px dotted #999;cursor:pointer;color:#2f434d}.rich-text #currency-tip{position:absolute;top:0;left:0;width:180px;padding:15px 20px;font-size:13px;line-height:18px;border-radius:4px;box-shadow:0 3px 6px #0006;z-index:55557!important;background-color:#fff}.rich-text .actions{margin-top:32px!important;margin-bottom:32px!important}.rich-text a.button{text-decoration:none!important}\\u0040media (min-width: 768px){.rich-text img{display:inline-block!important;padding:0;vertical-align:middle;max-width:276px}.rich-text img.small{max-width:254px!important}.rich-text img.medium{max-width:378px!important}.rich-text img.large{max-width:480px!important}.rich-text img.full{max-width:100\\u0025!important}.rich-text img.center{display:block!important;margin:0 auto}.rich-text img.half{max-width:354px;max-height:none!important;margin-left:12px;float:left}.rich-text img.third{max-width:250px!important;margin-left:12px;float:left}.rich-text img.third:first-child,.rich-text img.half:first-child{margin-left:0}.rich-text img.half:last-of-type,.rich-text img.third:last-of-type{float:none}.rich-text img.half:last-of-type:after,.rich-text img.third:last-of-type:after{content:\\\".\\\";display:block;height:0;clear:both;visibility:hidden}}\\u0040media (max-width: 767px){.rich-text img{max-width:100\\u0025}}.rich-text-section+.rich-text-section{margin-top:75px}.rich-text-section_title h1,.rich-text-section_title h2,.rich-text-section_title h3,.rich-text-section_title h4,.rich-text-section_title h5,.rich-text-section_title h6{margin-bottom:.8em!important}\\nimg{max-width:280px}.small{max-width:240px}.medium{max-width:320px}.large{max-width:360px}\\u003C/style>\\u003C/head>\\u003Cbody dir=\\\"ltr\\\" class=\\\"_8isn _agix x1 Locale_en_US\\\">\\u003Cdiv class=\\\"_8isn\\\">\\u003Cdiv class=\\\"_8iso\\\">\\u003Cdiv class=\\\"_8iu9\\\">\\u003Cdiv class=\\\"rich-text\\\">\\u003Ch1>About view once\\u003C/h1>\\u003Cp>You can send photos, voice messages, and videos that disappear from a chat after the recipient has opened them once.\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cdiv style=\\\"position:relative; overflow:hidden; width: 100\\u0025;padding-top: 56.25\\u0025;\\\">\\u003Ciframe src=\\\"https://faq.whatsapp.com/client_video/1493826764739720/?video_locale=en_US\\\" style=\\\"position:absolute; top:0; left:0; bottom:0; right:0; width:100\\u0025; height:100\\u0025;\\\" frameborder=\\\"0\\\" allowfullscreen=\\\"1\\\">\\u003C/iframe>\\u003C/div>\\u003Ch3>Sending view once media and voice messages\\u003C/h3>\\u003Cp>You&rsquo;ll need to select view once each time you want to send a view once photo, video or voice message. Read \\u003Ca href=\\\"https://faq.whatsapp.com/578442220724722/?helpref=inline\\\" data-lnfb-mode=\\\"ie\\\">this article\\u003C/a> to find out how.\\u003C/p>\\u003Cp>Once you send a view once photo, video, or voice message, you won&rsquo;t be able to view it again.\\u003C/p>\\u003Cp>To see if a recipient has opened a view once photo, video, or voice message, they&rsquo;ll need to have read receipts turned on.\\u003C/p>\\u003Cp>Any photos or videos you send won&rsquo;t be saved to the recipient&rsquo;s Photos or Gallery.\\u003C/p>\\u003Cp>The recipient also can&rsquo;t take a screenshot of anything you send using view once.\\u003C/p>\\u003Cp>\\u003Cb>Note:\\u003C/b>\\u003C/p>\\u003Cul>\\u003Cli>Only send view once photos, videos, or voice messages to people you trust. \\u003C/li>\\u003Cli>Remember that there are other ways your view once media or voice message can be saved or recorded. For example, recipients can take a photo or video of your view once media with a camera or other device before it disappears. \\u003C/li>\\u003Cli>Encrypted media may be stored for a few weeks on WhatsApp&rsquo;s servers after you&rsquo;ve sent it. \\u003C/li>\\u003Cli>If a recipient chooses to report view once media, or voice messages, the media, or voice messages will be provided to WhatsApp. Find out more \\u003Ca href=\\\"https://faq.whatsapp.com/1313491802751163/?helpref=inline\\\" data-lnfb-mode=\\\"ie\\\">about reporting messages\\u003C/a>.\\u003C/li>\\u003Cli>It's possible for iOS or Android users to record audio of view once messages using the native screen recorder.\\u003C/li>\\u003C/ul>\\u003Ch3>About receiving view once media and voice messages\\u003C/h3>\\u003Cp>Once you receive a view once photo, video, or voice message, you&rsquo;ll need to open it within 14 days of it being sent. Otherwise, it&rsquo;ll expire from the chat.\\u003C/p>\\u003Cp>You can&rsquo;t forward, copy, save, star, or share photos, voice messages, or videos that were sent or received with view once media enabled.\\u003C/p>\\u003Cp>View once media and voice messages can be restored from backups if the message is unopened at the time of back up. If the photo, voice message, or video was opened, it won&rsquo;t be included in the backup and can&rsquo;t be restored.\\u003C/p>\\u003Cp>You won&rsquo;t be able to take a screenshot of any view once media you receive.\\u003C/p>\\u003Ch3>Related resources:\\u003C/h3>\\u003Cp>\\u003Ca href=\\\"https://faq.whatsapp.com/578442220724722?helpref=rr\\\" data-lnfb-mode=\\\"ie\\\">How to send and open view once media\\u003C/a>\\u003C/p>\\u003C/div>\\u003Cdiv class=\\\"_a0jc\\\">\\u003Cdiv class=\\\"_aini\\\">Does this answer your question?\\u003C/div>\\u003Cdiv class=\\\"_ainj\\\">\\u003Ca