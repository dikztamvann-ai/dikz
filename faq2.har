\\\"> <style> .privacy_element, .privacy_element a, .privacy_element img { text-decoration:none; margin:0; padding:0; border:none; }  #privacy_icon { position:absolute; z-index:100; bottom:0px;top:auto;vertical-align:bottom;margin-bottom:1px;   left:16px;right:auto;text-align:left;margin-left:1px;  } #privacy_icon .privacy_out { width:19px; height:15px; line-height:0; z-index:150; display: block;  position: relative; } #privacy_icon .privacy_hover { width:77px; height:15px; line-height:0; z-index:100; }  #privacy_safe_click_zone { position:absolute; z-index:90; width:46px; height:31px;  bottom:0px;top:auto;vertical-align:bottom;   left:0px;right:auto;text-align:left;  } .ad_closed #privacy_safe_click_zone { display: none; }    #close_button { text-decoration:none; margin:0; padding:0; border:none;  position:absolute; z-index:100; bottom:0px;top:auto;vertical-align:bottom;margin-bottom:1px;  left:0px;right:auto;text-align:left;margin-left:1px;  display:block; width:15px; height:15px; } #close_button #close_button_svg { width:15px; height:15px; line-height:0;  position: relative; } .ad_closed #close_button { display: none; }  .privacy_hidden .privacy_element { display: none!important; } .ad_closed #privacy_icon { top: 0px; right: 0px; left: auto; margin-top: 0px; margin-right: 0px; z-index: 250; } </style> <div id=\\\"privacy_icon\\\" class=\\\"privacy_element\\\">  <div class=\\\"privacy_out\\\">  <img style=\\\"width:19px; height:15px;  position:absolute;bottom:0;left:0; \\\" src=\\\"https://static.criteo.net/flash/icon/privacy_small.svg\\\" />  </div>  <a style=\\\"display:none;\\\" class=\\\"privacy_hover\\\" target=\\\"_blank\\\"> <img style=\\\"width:77px;height:15px\\\" src=\\\"https://static.criteo.net/flash/icon/adchoices_en.svg\\\" /> </a> </div>  <div id=\\\"privacy_safe_click_zone\\\"></div>   <div id=\\\"close_button\\\"> <img id=\\\"close_button_svg\\\" src=\\\"https://static.criteo.net/flash/icon/close_button.svg\\\" /> </div>   <style> #survey_page { position: absolute; z-index: 200; top: 0px; left: 0px; width: 100%; height: 100%; display: none; text-align: center; background-color: #f4f3f3; font-family: \\\"Century Gothic\\\", Verdana; cursor: auto; } #survey_page > * { display: none; flex-direction: column; } #survey_page > *:first-child { display: flex; } #survey_page:lang(ja) { font-family: \\\"ヒラギノ角ゴ ProN\\\", \\\"Hiragino Kaku Gothic ProN\\\", \\\"メイリオ\\\", Meiryo, \\\"游ゴシック\\\", \\\"游ゴシック体\\\", YuGothic, \\\"Yu Gothic\\\", \\\"ＭＳ ゴシック\\\", \\\"MS Gothic\\\", HiraKakuProN-W3, \\\"TakaoExゴシック\\\", TakaoExGothic, \\\"MotoyaLCedar\\\", \\\"Droid Sans Japanese\\\", sans-serif; word-break: keep-all; line-break: strict; overflow-wrap: break-word; } #survey_page:lang(ko) { font-family: \\\"Apple SD Gothic Neo\\\", \\\"NanumBarunGothic\\\", \\\"맑은 고딕\\\", \\\"Malgun Gothic\\\", \\\"굴림\\\", \\\"Gulim\\\", \\\"돋움\\\", \\\"Dotum\\\", \\\"Helvetica Neue\\\", \\\"Helvetica\\\", Arial, sans-serif; } .ad_closed #survey_page { display: block; } #survey_menu_report_ad_button, .survey_answer_button, .survey_privacy_button { padding: 1px 5px; width: 120px; height: 40px; font-size: 14px; border-radius: 8px; } #survey_debug_info { font-size: 14px; position: relative; align-items: center; display: none; flex-direction: row; margin-top: 30px; text-decoration: none; user-select: none; } #survey_debug_info.add_survey_debug_info_title { display: flex; } #survey_menu { align-items: center; position: relative; justify-content: space-evenly; opacity: 1; } #survey_back_button { position: absolute; top: 5px; left: 5px; text-align: left; display: none; } #survey_back_button.add_back_button { display: block; } #survey_title { color: #848484; font-size: 18px; display: block; margin: 2px 19px 0; } #survey_title_logo { width: 65px; } #survey_answers_wrapper { align-items: center; position: relative; opacity: 0; height: 100%; width: 100%; } #survey_menu_report_ad_button { position: relative; align-items: center; color: white; background-color: #ff8100; border: 1px solid #848484; display: flex; flex-direction: row; margin: 30px 19px 0; cursor: pointer; text-decoration: none; user-select: none; } #survey_menu_report_ad_button:hover { background-color: #e47303; } #survey_menu_report_ad_button:focus { outline: 0; } #survey_menu_report_ad_button_title { margin: 0 auto; } .survey_answer_button { position: relative; height: 50px; color: #ff8100; background-color: white; border: 1px solid #848484; display: inline-block; margin: 3px; cursor: pointer; word-break: break-word; user-select: none; } .survey_answer_button:hover { background-color: #e4e2da; } .survey_answer_button:active { background-color: #e4e2da; } .survey_answer_button:focus { outline: 0; } #survey_thanks_title { color: #848484; font-size: 14px; } #survey_thanks_wrapper { align-items: center; position: relative; margin-top: 30px; opacity: 0; } .survey_privacy_button { position: relative; align-items: center; color: #848484; background-color: white; border: 1px solid #848484; display: flex; flex-direction: row; margin-top: 30px; text-decoration: none; user-select: none; } .survey_privacy_button:lang(de) { font-size: 13.5px; } .survey_privacy_button:hover { background-color: #e4e2da; } .survey_privacy_button:focus { outline: 0; } .survey_privacy_button_title { margin: 0 2px 0 auto; } .survey_privacy_icon_img { position: relative; margin-right: auto; } .survey_answer_button:lang(ja), .survey_privacy_button:lang(ja) { word-break: keep-all; padding: 1px 2px; } @keyframes fade-out { 0% { opacity: 1; } 100% { opacity: 0; } } @keyframes fade-in { 0% { opacity: 0; } 100% { opacity: 1; } } #survey_title.nologo #survey_title_logo { display: none; } @media screen { @media (min-height: 225px) { .survey_answer_button:first-child { margin-top: 10px; } @media (max-height: 245px) { .survey_answer_button:first-child { margin-top: 2vh; margin-top: calc(35vh - 75.75px); } } } @media (min-height: 150px) and (max-height: 165px) and (max-aspect-ratio: 2/1) { #survey_menu_report_ad_button { margin-top: 15px; margin-top: calc(100vh - 135px); } } @media (max-height: 225px) and (max-aspect-ratio: 2/1) { #survey_title { margin: 2px auto 0; font-size: 13.5px; } #survey_menu_report_ad_button, .survey_privacy_button, #survey_thanks_wrapper { margin-top: 10px; margin-top: calc(10px + (100vh - 150px) * 0.08); } #survey_menu_report_ad_button, #survey_thanks_wrapper { margin-top: calc(9px + (100vh - 150px) * 0.28); } .survey_answer_button { margin: 1px 3px; } @media (min-height: 211px) { .survey_answer_button { margin: calc(0.9px + 0.14 * (100vh - 210px)) 3px; } } @media (max-width: 190px) { .survey_answer_button { width: 90vw; font-size: 12px; font-size: calc(12px + 0.02 * (100vh - 150px)); } @media (min-height: 135px) and (max-height: 150px) { .survey_answer_button { width: calc(90vw + 0.2 * (225px - 100vh)); } } @media (max-height: 150px) { .survey_answer_button { padding: 1px; width: calc(100vw - 8px); } } } } @media (max-height: 225px) and (min-aspect-ratio: 2/1) { #survey_page > * { display: none; flex-direction: row; height: 100%; justify-content: center; } #survey_menu_report_ad_button, #survey_title, #survey_thanks_wrapper, .survey_privacy_button { margin: 0 5px; } @media (max-width: 350px) { .survey_answer_button:lang(ja) { line-height: 1.3em; } } @media (max-height: 60px) { .survey_answer_button { height: 45px; height: calc(45px + 0.5 * (100vh - 50px)); font-size: 11.5px; font-size: calc(11.5px + 0.2 * (100vh - 50px)); margin: 0 2px; } #survey_back_button { top: 0px; left: 0px; } .back_button_underlay img { background-color: rgba(255, 255, 255, 0.6); border-bottom-right-radius: 30%; } @media (max-width: 360px) { #survey_thanks_title:lang(ja), #survey_thanks_title:lang(ko) { line-height: 1.3em; } } @media (max-width: 445px) { #survey_menu_report_ad_button, #survey_menu .survey_privacy_button, #survey_title { margin: 0 2px; } #survey_title { font-size: 14px; } #survey_menu_report_ad_button, #survey_menu .survey_privacy_button { font-size: 12px; } @media (min-width: 405px) { #survey_title { font-size: calc(14px + 0.075 * (100vw - 405px)); } } } } @media (max-width: 360px) and (min-height: 60px) and (max-height: 150px) { .survey_answer_button { font-size: 13.5px; margin: 0 2px; } } @media (max-width: 500px) { #survey_title { max-width: calc(100vw - 250px); } #survey_thanks_title { max-width: calc(100vw - 100px); } #survey_thanks_wrapper, #survey_thanks_wrapper .survey_privacy_button { margin: 0 calc(2px + (100vw - 320px) / 60); } .survey_answer_button { padding: 1px; font-size: 11.5px; } @media (min-height: 60px) and (min-width: 400px) { .survey_answer_button { font-size: calc(11.5px + 0.025 * (100vw - 400px)); } } @media (max-width: 445px) { #survey_title > span { display: none; } #survey_title.nologo #survey_title_logo { display: inline; } @media (max-width: 400px) { .survey_answer_button { margin: 0 0.5px; } #survey_thanks_title { font-size: 13px; } #survey_thanks_title:lang(ja) { font-size: 11.5px; } #survey_thanks_wrapper:lang(ja) .survey_privacy_button { width: 100px; } @media (min-width: 350px) { .survey_answer_button { margin: 0 calc(0.5px + 0.03 * (100vw - 350px)); } } } } } } @media (max-width: 130px) { #survey_menu_report_ad_button, .survey_privacy_button, .survey_answer_button { width: 92vw; padding: 1px; } #survey_menu_report_ad_button:lang(ja), .survey_answer_button:lang(ja) { padding: 1px; line-height: 1.3em; height: 56px; } #survey_menu_report_ad_button:lang(ja), .survey_privacy_button:lang(ja) { margin-top: 15px; } #survey_menu_report_ad_button:lang(de), .survey_privacy_button:lang(de) { font-size: 12px; } #survey_back_button { top: 0px; left: 0px; } body.privacy_hidden #survey_back_button img, .back_button_underlay img { background-color: rgba(255, 255, 255, 0.6); border-bottom-right-radius: 30%; } } }\\n</style> <div id=\\\"survey_page\\\"> <div id=\\\"survey_menu\\\"> <span id=\\\"survey_title\\\"></span> <a id=\\\"survey_menu_report_ad_button\\\" type=\\\"button\\\"> <span id=\