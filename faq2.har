afe_click_zone { position:absolute; z-index:90; width:46px; height:31px;  top:0px;bottom:auto;vertical-align:top;   right:0px;left:auto;text-align:right;  } .ad_closed #privacy_safe_click_zone { display: none; }    #close_button { text-decoration:none; margin:0; padding:0; border:none;  position:absolute; z-index:100; top:0px;bottom:auto;vertical-align:top;margin-top:1px;  right:0px;left:auto;text-align:right;margin-right:1px;  display:block; width:15px; height:15px; } #close_button #close_button_svg { width:15px; height:15px; line-height:0;  } .ad_closed #close_button { display: none; }  .privacy_hidden .privacy_element { display: none!important; } .ad_closed #privacy_icon { top: 0px; right: 0px; left: auto; margin-top: 0px; margin-right: 0px; z-index: 250; } </style> <div id=\\\"privacy_icon\\\" class=\\\"privacy_element\\\">  <div class=\\\"privacy_out\\\">  <img style=\\\"width:19px; height:15px;  \\\" src=\\\"https://static.criteo.net/flash/icon/privacy_small.svg\\\" />  </div>  <a style=\\\"display:none;\\\" class=\\\"privacy_hover\\\" target=\\\"_blank\\\"> <img style=\\\"width:77px;height:15px\\\" src=\\\"https://static.criteo.net/flash/icon/adchoices_en.svg\\\" /> </a> </div>  <div id=\\\"privacy_safe_click_zone\\\"></div>   <div id=\\\"close_button\\\"> <img id=\\\"close_button_svg\\\" src=\\\"https://static.criteo.net/flash/icon/close_button.svg\\\" /> </div>   <style> #survey_page { position: absolute; z-index: 200; top: 0px; left: 0px; width: 100%; height: 100%; display: none; text-align: center; background-color: #f4f3f3; font-family: \\\"Century Gothic\\\", Verdana; cursor: auto; } #survey_page > * { display: none; flex-direction: column; } #survey_page > *:first-child { display: flex; } #survey_page:lang(ja) { font-family: \\\"ヒラギノ角ゴ ProN\\\", \\\"Hiragino Kaku Gothic ProN\\\", \\\"メイリオ\\\", Meiryo, \\\"游ゴシック\\\", \\\"游ゴシック体\\\", YuGothic, \\\"Yu Gothic\\\", \\\"ＭＳ ゴシック\\\", \\\"MS Gothic\\\", HiraKakuProN-W3, \\\"TakaoExゴシック\\\", TakaoExGothic, \\\"MotoyaLCedar\\\", \\\"Droid Sans Japanese\\\", sans-serif; word-break: keep-all; line-break: strict; overflow-wrap: break-word; } #survey_page:lang(ko) { font-family: \\\"Apple SD Gothic Neo\\\", \\\"NanumBarunGothic\\\", \\\"맑은 고딕\\\", \\\"Malgun Gothic\\\", \\\"굴림\\\", \\\"Gulim\\\", \\\"돋움\\\", \\\"Dotum\\\", \\\"Helvetica Neue\\\", \\\"Helvetica\\\", Arial, sans-serif; } .ad_closed #survey_page { display: block; } #survey_menu_report_ad_button, .survey_answer_button, .survey_privacy_button { padding: 1px 5px; width: 120px; height: 40px; font-size: 14px; border-radius: 8px; } #survey_debug_info { font-size: 14px; position: relative; align-items: center; display: none; flex-direction: row; margin-top: 30px; text-decoration: none; user-select: none; } #survey_debug_info.add_survey_debug_info_title { display: flex; } #survey_menu { align-items: center; position: relative; justify-content: space-evenly; opacity: 1; } #survey_back_button { position: absolute; top: 5px; left: 5px; text-align: left; display: none; } #survey_back_button.add_back_button { display: block; } #survey_title { color: #848484; font-size: 18px; display: block; margin: 2px 19px 0; } #survey_title_logo { width: 65px; } #survey_answers_wrapper { align-items: center; position: relative; opacity: 0; height: 100%; width: 100%; } #survey_menu_report_ad_button { position: relative; align-items: center; color: white; background-color: #ff8100; border: 1px solid #848484; display: flex; flex-direction: row; margin: 30px 19px 0; cursor: pointer; text-decoration: none; user-select: none; } #survey_menu_report_ad_button:hover { background-color: #e47303; } #survey_menu_report_ad_button:focus { outline: 0; } #survey_menu_report_ad_button_title { margin: 0 auto; } .survey_answer_button { position: relative; height: 50px; color: #ff8100; background-color: white; border: 1px solid #848484; display: inline-block; margin: 3px; cursor: pointer; word-break: break-word; user-select: none; } .survey_answer_button:hover